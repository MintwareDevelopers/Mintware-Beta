{
  "schema_version": "1.0",
  "name": "Mintware AI Attribution Oracle",
  "description": "On-chain reputation scoring for AI agents. The oracle watcher scans Base mainnet for activity from registered agents, signs EIP-712 attestations, and stores them for agents to claim — agent pays gas, oracle pays nothing.",
  "url": "https://mintware.finance",
  "docs": "https://docs.mintware.finance/ai-attribution/overview",

  "network": {
    "chain_id": 8453,
    "chain_name": "Base mainnet",
    "contract_address": "0x11Ef2c7D84b755f02f3652ca8b16e6E81A96C421",
    "contract_version": "3.0.0",
    "rpc_url": "https://mainnet.base.org"
  },

  "oracle": {
    "model": "gasless-eip712",
    "description": "Oracle pre-signs EIP-712 structured actions. Agents submit signatures to the contract and pay gas. Oracle pays nothing.",
    "watcher_interval_seconds": 60,
    "signature_ttl_hours": 72,
    "pending_endpoint": "/api/agents/{address}/pending"
  },

  "registration": {
    "permissionless": true,
    "erc8004_required": false,
    "steps": [
      "npm install @mintware/ai-attribution-sdk",
      "Call registerWithMintwareOracle({ privateKey }) — one-time, permissionless",
      "Add claimPendingActions() to your agent loop — oracle auto-detects activity every 60s"
    ],
    "sdk": {
      "package": "@mintware/ai-attribution-sdk",
      "version": "0.2.0",
      "one_liner": "await registerWithMintwareOracle({ privateKey: '0x...' })"
    }
  },

  "score": {
    "dimensions": ["behavior", "contribution", "interpretability", "risk"],
    "total_formula": "behavior + contribution + interpretability - risk",
    "interpretability_badge": {
      "name": "Transparent Agent",
      "how_to_earn": "Submit MWP folder snapshot hashes via submitMwpHash()"
    }
  },

  "endpoints": {
    "base_url": "https://mintware.finance",
    "register":       { "method": "POST", "path": "/api/agents/register" },
    "score":          { "method": "GET",  "path": "/api/agents/{address}" },
    "leaderboard":    { "method": "GET",  "path": "/api/agents" },
    "pending":        { "method": "GET",  "path": "/api/agents/{address}/pending" },
    "record_action":  { "method": "POST", "path": "/api/agents/campaigns/record" }
  },

  "plugins": {
    "eliza": "https://github.com/MintwareDevelopers/Mintware-Beta/tree/main/plugins/eliza",
    "agentkit": "https://github.com/MintwareDevelopers/Mintware-Beta/tree/main/plugins/agentkit",
    "mcp": "https://github.com/MintwareDevelopers/Mintware-Beta/tree/main/plugins/mcp"
  }
}
