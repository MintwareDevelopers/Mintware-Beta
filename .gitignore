# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# never commit nested package dirs (plugins/*, oracle-watcher, subgraph, …)
**/node_modules/

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# macOS
.DS_Store
**/.DS_Store

# typescript
*.tsbuildinfo
next-env.d.ts

# hardhat
/hardhat-artifacts
/hardhat-cache
/deployments
# Private reference files
# Root-anchored: a personal WEB3.md scratch file at repo root. Unanchored "WEB3.md"
# also swallowed .claude/rules/web3.md on case-insensitive filesystems (macOS) — the
# reason that rule file silently vanished. Keep this anchored to root only.
/WEB3.md
.claude/settings.local.json

# Foundry compiled artifacts
contracts-v4/out/
contracts-v4/cache/

# contracts-ai — compiled artifacts and installed libs
contracts-ai/out/
contracts-ai/cache/
contracts-ai/lib/

# Claude worktrees — local-only, never commit
.claude/worktrees/
.claude-octopus/
.claire/
GEMINI.md

# Foundry broadcast + cache artifacts
broadcast/
cache/
out/

# Oracle watcher — has its own node_modules
oracle-watcher/node_modules/

# Subgraph node_modules
subgraph/node_modules/
.aidesigner/*
!.aidesigner/.gitkeep
