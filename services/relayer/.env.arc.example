# YPN relayer — Arc testnet config. Copy to .env and fill the secrets.
# The relayer submits settleSpend (card settlement) AND CCTP receiveAndDeposit (cross-chain deposit) on Arc.

# Destination chain (Arc) — where settlement + the CCTP mint happen.
RELAYER_RPC_URL=https://rpc.testnet.arc.io

# Live Arc contracts.
GATEWAY_ADDRESS=0x1D075cB38f5c126D9c23f1f91faC0A9C8d135399
ARC_CCTP_ROUTER=0xDB9DB7008cfFb09bD1D943C237f57327383DFc03

# CCTP source (where USDC is burned) + Circle attestation service.
CCTP_SOURCE_RPC_URL=https://sepolia.base.org
CCTP_SOURCE_DOMAIN=6
IRIS_BASE_URL=https://iris-api-sandbox.circle.com

# Secret — REQUIRED. Must derive an address holding RELAYER_ROLE on the gateway
# (and be the router's `relayer` for receiveAndDeposit).
# The HTTP server (relayer-server bin) reads RELAYER_SIGNER_KEY first, then falls back to this name.
RELAYER_SUBMIT_KEY=

# ── Always-on HTTP settle server (relayer-server bin) ──────────────────────────────────────────────
# Serves POST /settle + POST /settle-batch (and GET /health). All fail closed until set.
# Bind port (default 8080).
PORT=8080
# Bearer secret guarding /settle + /settle-batch. UNSET ⇒ every settle request is 401 (fail closed).
RELAYER_HTTP_SECRET=
# Funded signer key for the server (canonical name). Falls back to RELAYER_SUBMIT_KEY above.
# UNSET / invalid ⇒ settle returns 503 signer_unavailable (never runs keyless). Never log/commit it.
RELAYER_SIGNER_KEY=
# Default MintwarePaymentGateway for /settle (per-request `gateway` overrides). Falls back to GATEWAY_ADDRESS.
RELAYER_GATEWAY_ADDRESS=0x1D075cB38f5c126D9c23f1f91faC0A9C8d135399
# Default MintwareEthSettlement for /settle-batch (per-request `settlement` overrides). Falls back to SETTLEMENT_ADDRESS.
RELAYER_SETTLEMENT_ADDRESS=
