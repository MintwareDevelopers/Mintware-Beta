# YPN edge-auth — Arc testnet config. Copy to .env and fill the secrets.
# Points the running edge-auth service at the LIVE Arc spend stack (deployed 2026-08-16).

# Chain — EDGE_CHAIN_ID makes the EDGE_SIGNER's EIP-712 domain correct for Arc automatically.
EDGE_CHAIN_ID=5042002
EDGE_RPC_URL=https://rpc.testnet.arc.io

# Live Arc contracts (from DeployArcSpendStack).
EDGE_GATEWAY_ADDRESS=0x1D075cB38f5c126D9c23f1f91faC0A9C8d135399
EDGE_VAULT_ADDRESS=0x11Ef2c7D84b755f02f3652ca8b16e6E81A96C421
EDGE_VAULT_KIND=v1
EDGE_COLLATERAL=usdc

# NAV refresher.
EDGE_NAV_REFRESH_SECS=15
EDGE_MAX_NAV_AGE_SECS=30
EDGE_HOLD_TTL_SECS=600
# EDGE_USERS=0x9c646C48a302f4725450669f1218d3FDb3e933AD   # comma-separated tracked users

# Secrets — REQUIRED to enforce (fail closed if unset):
#   EDGE_SIGNER_KEY  must derive an address holding EDGE_SIGNER_ROLE on the gateway (>=$250 lane)
#   EDGE_API_SECRET  bearer for POST /authorize + /holds
EDGE_SIGNER_KEY=
EDGE_API_SECRET=

PORT=8080
