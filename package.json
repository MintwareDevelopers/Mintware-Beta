{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "TS_NODE_PROJECT=tsconfig.hardhat.json npx hardhat test --config hardhat.config.cts",
    "test:all": "pnpm test && pnpm hardhat:test && pnpm forge:test",
    "hardhat:compile": "TS_NODE_PROJECT=tsconfig.hardhat.json npx hardhat compile --config hardhat.config.cts",
    "hardhat:test": "TS_NODE_PROJECT=tsconfig.hardhat.json npx hardhat test --config hardhat.config.cts",
    "hardhat:deploy:base-sepolia": "TS_NODE_PROJECT=tsconfig.hardhat.json npx hardhat run scripts/deploy.cjs --network base_sepolia --config hardhat.config.cts",
    "hardhat:deploy:base": "TS_NODE_PROJECT=tsconfig.hardhat.json npx hardhat run scripts/deploy.cjs --network base --config hardhat.config.cts",
    "hardhat:deploy:core-dao": "TS_NODE_PROJECT=tsconfig.hardhat.json npx hardhat run scripts/deploy.cjs --network core_dao --config hardhat.config.cts",
    "hardhat:deploy:bnb": "TS_NODE_PROJECT=tsconfig.hardhat.json npx hardhat run scripts/deploy.cjs --network bnb --config hardhat.config.cts",
    "hardhat:deploy:arbitrum-sepolia": "TS_NODE_PROJECT=tsconfig.hardhat.json npx hardhat run scripts/deploy.cjs --network arbitrum_sepolia --config hardhat.config.cts",
    "hardhat:deploy:arbitrum": "TS_NODE_PROJECT=tsconfig.hardhat.json npx hardhat run scripts/deploy.cjs --network arbitrum --config hardhat.config.cts",
    "forge:build": "forge build",
    "forge:test": "forge test -vv",
    "forge:test:gas": "forge test -vv --gas-report",
    "forge:coverage": "forge coverage",
    "forge:deploy:base-sepolia": "forge script contracts-v4/script/Deploy.s.sol --rpc-url base_sepolia --broadcast --verify",
    "forge:deploy:base": "forge script contracts-v4/script/Deploy.s.sol --rpc-url base --broadcast --verify",
    "forge:deploy:phase3:base-sepolia": "forge script contracts-v4/script/DeployPhase3.s.sol --rpc-url base_sepolia --broadcast --verify -vvvv",
    "forge:deploy:phase3:base": "forge script contracts-v4/script/DeployPhase3.s.sol --rpc-url base --broadcast --verify -vvvv",
    "forge:deploy:phase3:dry-run": "forge script contracts-v4/script/DeployPhase3.s.sol --rpc-url base_sepolia -vvvv",
    "forge:rwa-vault-demo:base-sepolia": "forge script contracts-v4/script/DeployRwaVaultDemo.s.sol --rpc-url base_sepolia --broadcast -vvvv",
    "forge:rwa-vault-demo:dry-run": "forge script contracts-v4/script/DeployRwaVaultDemo.s.sol -vvvv",
    "ai:build": "forge build --root contracts-ai",
    "ai:test": "forge test --root contracts-ai -vv",
    "ai:deploy:base-sepolia": "forge script contracts-ai/script/Deploy.s.sol --root contracts-ai --rpc-url base_sepolia --broadcast --verify -vvvv",
    "ai:deploy:base": "forge script contracts-ai/script/Deploy.s.sol --root contracts-ai --rpc-url base --broadcast --verify -vvvv",
    "anchor:build": "anchor build",
    "anchor:test": "anchor test",
    "anchor:deploy:devnet": "anchor deploy --provider.cluster devnet",
    "anchor:deploy:mainnet": "anchor deploy --provider.cluster mainnet"
  },
