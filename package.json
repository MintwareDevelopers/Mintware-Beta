{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm test && pnpm forge:test",
    "forge:build": "forge build",
    "forge:test": "forge test -vv",
    "forge:test:gas": "forge test -vv --gas-report",
    "forge:coverage": "forge coverage",
    "forge:smoke:coverage-gate": "forge script contracts-v4/script/SmokeCoverageGate.s.sol --rpc-url base_sepolia",
    "forge:deploy:treasury-v2:base-sepolia": "forge script contracts-v4/script/DeployTreasuryV2.s.sol --rpc-url base_sepolia --broadcast --slow -vvvv",
    "forge:deploy:treasury-v2:dry-run": "forge script contracts-v4/script/DeployTreasuryV2.s.sol --rpc-url base_sepolia -vvvv",
    "forge:deploy:treasury-factory:base-sepolia": "forge script contracts-v4/script/DeployTreasuryFactory.s.sol --rpc-url base_sepolia --broadcast --slow -vvvv",
    "forge:create-treasury-vault:base-sepolia": "forge script contracts-v4/script/CreateTreasuryVault.s.sol --rpc-url base_sepolia --broadcast --slow -vvvv",
    "forge:deploy:arc-spend:arc": "forge script contracts-v4/script/DeployArcSpendStack.s.sol --rpc-url arc --broadcast --slow -vvvv",
    "forge:deploy:arc-spend:dry-run": "forge script contracts-v4/script/DeployArcSpendStack.s.sol -vvvv",
    "forge:deploy:eth-settlement:base-sepolia": "forge script contracts-v4/script/DeployEthSettlement.s.sol --rpc-url base_sepolia --broadcast --slow -vvvv",
    "forge:deploy:eth-collateral:base-sepolia": "forge script contracts-v4/script/DeployEthCollateralVault.s.sol --rpc-url base_sepolia --broadcast --slow -vvvv",
    "forge:deploy:pair:base-sepolia": "forge script contracts-v4/script/DeployPairVault.s.sol --rpc-url base_sepolia --broadcast --verify -vvvv",
    "forge:deploy:pair:dry-run": "forge script contracts-v4/script/DeployPairVault.s.sol --rpc-url base_sepolia -vvvv",
    "forge:deploy:matched:base-sepolia": "forge script contracts-v4/script/DeployMatchedVault.s.sol --rpc-url base_sepolia --broadcast --verify -vvvv",
    "forge:deploy:matched:dry-run": "forge script contracts-v4/script/DeployMatchedVault.s.sol --rpc-url base_sepolia -vvvv",
    "forge:deploy:weighted:base-sepolia": "forge script contracts-v4/script/DeployWeightedDistributor.s.sol --rpc-url base_sepolia --broadcast --verify -vvvv",
    "forge:deploy:weighted:dry-run": "forge script contracts-v4/script/DeployWeightedDistributor.s.sol --rpc-url base_sepolia -vvvv",
    "ai:build": "forge build --root contracts-ai",
    "ai:test": "forge test --root contracts-ai -vv",
    "ai:deploy:base-sepolia": "forge script contracts-ai/script/Deploy.s.sol --root contracts-ai --rpc-url base_sepolia --broadcast --verify -vvvv",
    "ai:deploy:base": "forge script contracts-ai/script/Deploy.s.sol --root contracts-ai --rpc-url base --broadcast --verify -vvvv",
    "anchor:build": "anchor build",
    "anchor:test": "anchor test",
    "anchor:deploy:devnet": "anchor deploy --provider.cluster devnet",
    "anchor:deploy:mainnet": "anchor deploy --provider.cluster mainnet",
    "context:sync": "node scripts/context-sync.mjs",
    "context:check": "node scripts/context-sync.mjs --check"
  },
